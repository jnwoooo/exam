# .env.example — 복사해서 .env로 쓴다(cp .env.example .env). .env는 비밀값이 들어가므로 공유·커밋하지 않는다
# 두 서버·색인기·관리 명령이 모두 이 파일을 읽는다(common/settings.py). 실제 환경변수가 있으면 그쪽이 우선

# ── 로컬 docker 인프라 ──
DATABASE_URL=postgresql://llmv3:llmv3@localhost:5432/codeagent   # docker/postgres (DB는 python -m common.db로 생성)
REDIS_URL=redis://localhost:6379/0                                # docker/redis
QDRANT_URL=http://localhost:6333                                  # docker/qdrant
QDRANT_API_KEY=                                                   # Qdrant에 키를 켰으면 입력

# ── 임베딩(로컬 Python) ──
EMBED_MODEL=nlpai-lab/KoE5        # 폐쇄망이면 받아 둔 모델 폴더 경로(예: /models/KoE5) — 폴더면 자동으로 오프라인 모드
EMBED_DEVICE=                     # 비우면 자동(Mac은 mps). 문제가 있으면 cpu

# ── RAG 서비스(:8100) ──
RAG_URL=http://127.0.0.1:8100
INDEX_TOKENS=change-me-index      # RAG가 받는 색인 토큰(쉼표로 여러 개)
SEARCH_TOKENS=change-me-search    # RAG가 받는 검색 토큰(쉼표로 여러 개)
INDEX_TOKEN=change-me-index       # 색인기가 보내는 토큰(INDEX_TOKENS 중 하나)
SEARCH_TOKEN=change-me-search     # 코드에이전트 서버가 보내는 토큰(SEARCH_TOKENS 중 하나)
PERM_CACHE_TTL=300                # 권한 캐시(초)

# ── 외부 LLM(gemma4) ──
LLM_BASE_URL=http://0.0.0.0:8000/v1   # ★ 실제 외부 호스트 주소로 교체(OpenAI 호환 /v1). 가짜 LLM 시험: http://127.0.0.1:8300/v1
LLM_API_KEY=                          # 외부 LLM 키(있으면). 서버만 가지며 PC(Continue)에는 배포하지 않는다
LLM_MODEL=gemma4-26b-32k:latest
LLM_TIMEOUT=180

# ── 사용량 한도 ──
LIMIT_RPM=60                      # 사용자별 분당 LLM 요청(Continue 채팅 + request_fix 안쪽)
LIMIT_DAILY_TOKENS=2000000        # 사용자별 하루 토큰

# ── 코드에이전트 서버(:8200) ──
AGENT_HOST=127.0.0.1              # 다른 PC에서 접속하게 하려면 0.0.0.0
AGENT_PORT=8200
FIX_MAX_CODE_CHARS=20000          # request_fix로 받을 코드 상한(32k 컨텍스트 보호)
FIX_MAX_RETRIES=2                 # 검증 실패 시 재생성 횟수

# ── 색인기 ──
# 형식: 이름|git주소|브랜치|컬렉션 ; 로 여러 개. 이름은 권한 DB 항목(scopes.repo)과 같아야 색인된다
INDEX_REPOS=shop|https://git.example.com/team/shop.git|main|code;guide|https://git.example.com/team/dev-guide.git|main|docs
INDEX_CACHE_DIR=                  # 비우면 ./.repos
INDEX_STATE=                      # 비우면 ./.repos/index_state.json

# ── (참고 구현) llm_server — 외부 호스트에 둘 "LLM 앞의 FastAPI" 예측 코드. 코드에이전트 서버와는 별개 프로그램 ──
LLM_SERVER_BACKEND_URL=http://localhost:11434   # Ollama 주소(gemma4가 올라간 곳). 가짜: python -m tools.fake_ollama
LLM_SERVER_BACKEND_MODEL=gemma4-26b-32k:latest
LLM_SERVER_TOOL_MODE=native       # native: Ollama tools 기능 / prompt: 도구 미지원 모델을 프롬프트로 흉내
LLM_SERVER_NUM_CTX=32768
LLM_SERVER_KEYS=                  # 받을 API 키(쉼표). 비우면 인증 없음 — 쓰면 코드에이전트 .env의 LLM_API_KEY와 같게
LLM_SERVER_PORT=8000
